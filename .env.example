# Plantilla de Variables de Entorno para Reciclaje Litoral (.env.example)

# Base de Datos PostgreSQL
POSTGRES_DB={reciclaje_db}
POSTGRES_USER={reciclaje_user}
POSTGRES_PASSWORD={reciclaje_password}

# Perfil de AWS CLI (Opcional, reutiliza las credenciales de ~/.aws/credentials)
AWS_PROFILE=default

# Credenciales de AWS explícitas (Opcional, para subida real a Amazon S3)
AWS_ACCESS_KEY_ID={access_key_id}
AWS_SECRET_ACCESS_KEY={access_key_secret}

# Nombre del Bucket real de AWS S3 y Región
AWS_S3_BUCKET={aws_s3_bucket_name}
AWS_REGION={aws_region}

# Clave secreta HMAC-SHA256 para firma de Tokens JWT (mínimo 256 bits)
JWT_SECRET={jwt_secret_key}

# API Base URL para el Frontend React
VITE_API_URL=/api
