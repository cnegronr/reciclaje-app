{
  "name": "reciclaje-cdk",
  "version": "1.0.0",
  "description": "AWS CDK Infrastructure Stack for Reciclaje Litoral (S3, EC2 Graviton, VPC, Elastic IP)",
  "bin": {
    "reciclaje-cdk": "bin/reciclaje-cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:clean": "node scripts/deploy.js --mode=clean",
    "deploy:update": "node scripts/deploy.js --mode=update",
    "deploy": "node scripts/deploy.js --mode=update",
    "ssm:push": "node scripts/sync-ssm-params.js --action=push",
    "ssm:list": "node scripts/sync-ssm-params.js --action=list"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.130.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.130.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
